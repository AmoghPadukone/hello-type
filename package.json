{
  "name": "hellotype",
  "version": "1.0.0",
  "private": true,
  "description": "Write any word in Apple's “hello” script. Export SVG, animated SVG, PNG, or a watertight 3D-printable model.",
  "keywords": [
    "cursive",
    "handwriting",
    "svg",
    "3d-printing",
    "3mf",
    "stl",
    "three.js",
    "manifold",
    "react"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Amogh Padukone (https://github.com/AmoghPadukone)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "glyphs": "python3 scripts/build_glyphs.py",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.4.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "manifold-3d": "3.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
